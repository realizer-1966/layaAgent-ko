{
  "name": "laya-agent-ko",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "layaAgent 한국어판: Laya 다국어 타입화 결정 인코더(System 1)가 일상적인 결정을 하고, 확신이 없을 때만 브라우저 속 WebLLM(System 2)이 나서며, 위험한 단계는 확인 게이트로 막는 브라우저 네이티브 AI 에이전트",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepare-site": "node scripts/prepare_site.mjs",
    "serve": "python serve.py"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@mlc-ai/web-llm": "0.2.79",
    "compromise": "14.17.0",
    "compromise-dates": "3.9.0",
    "cytoscape": "3.34.3",
    "cytoscape-dagre": "4.0.1",
    "onnxruntime-web": "1.30.0"
  }
}
